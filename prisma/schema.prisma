generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLINICIAN
  PARENT
}

enum GameType {
  FOCUS_HUNT
  SELECTIVE_ATTENTION
  INHIBITION
  WORKING_MEMORY
}

enum SessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ErrorType {
  OMISSION
  COMMISSION
  IMPULSIVE
  TIMEOUT
  OTHER
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      UserRole
  clinician Clinician?
  parent    Parent?
  createdAt DateTime  @default(now())
}

model Clinician {
  id       String          @id @default(cuid())
  userId   String          @unique
  user     User            @relation(fields: [userId], references: [id])
  children Child[]
  notes    ClinicianNote[]
}

model Parent {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  children Child[]
}

model Child {
  id               String            @id @default(cuid())
  displayName      String
  clinicianId      String
  clinician        Clinician         @relation(fields: [clinicianId], references: [id])
  parentId         String?
  parent           Parent?           @relation(fields: [parentId], references: [id])
  sessions         Session[]
  gameRuns         GameRun[]
  gameTrials       GameTrial[]
  difficultyStates DifficultyState[]
  cognitiveScores  CognitiveScore[]
  weeklyReports    WeeklyReport[]
  notes            ClinicianNote[]
  createdAt        DateTime          @default(now())
}

model Session {
  id              String           @id @default(cuid())
  childId         String
  child           Child            @relation(fields: [childId], references: [id])
  status          SessionStatus    @default(PLANNED)
  gameRuns        GameRun[]
  gameTrials      GameTrial[]
  cognitiveScores CognitiveScore[]
  createdAt       DateTime         @default(now())
}

model GameRun {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id])
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  gameType   GameType
  difficulty Int
  createdAt  DateTime @default(now())
}

model GameTrial {
  id               String    @id @default(cuid())
  childId          String
  child            Child     @relation(fields: [childId], references: [id])
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id])
  gameType         GameType
  difficulty       Int
  expectedResponse String
  actualResponse   String?
  correct          Boolean
  reactionTimeMs   Int?
  errorType        ErrorType?
  createdAt        DateTime  @default(now())
}

model DifficultyState {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id])
  gameType GameType
  level    Int      @default(1)

  @@unique([childId, gameType])
}

model CognitiveScore {
  id                    String    @id @default(cuid())
  childId               String
  child                 Child     @relation(fields: [childId], references: [id])
  sessionId             String?
  session               Session?  @relation(fields: [sessionId], references: [id])
  sustainedAttention    Int
  selectiveAttention    Int
  inhibition            Int
  workingMemory         Int
  reactionTimeStability Int
  sessionAdherence      Int
  calculatedAt          DateTime  @default(now())
}

model WeeklyReport {
  id            String   @id @default(cuid())
  childId       String
  child         Child    @relation(fields: [childId], references: [id])
  weekStart     DateTime
  summary       String
  scoreSnapshot Json

  @@unique([childId, weekStart])
}

model ClinicianNote {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id])
  clinicianId String
  clinician   Clinician @relation(fields: [clinicianId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
}
